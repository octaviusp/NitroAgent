# ── Single-agent mode (no agents.toml) ──
TELEGRAM_BOT_TOKEN=<telegram_bot_token>
ALLOWED_TELEGRAM_USER_IDS=<your_telegram_numeric_user_id>
DEFAULT_ENGINE=claude
DEFAULT_TOOL_MODE=safe
POLL_TIMEOUT_SECONDS=25
STREAM_EDIT_INTERVAL_SECONDS=0.7
MAX_RUNTIME_SECONDS=1200
MAX_OUTPUT_CHARS=3500
DB_PATH=data/nitro_agent.db
WORKSPACE_ROOT=workspaces
LOGS_ROOT=logs
CLAUDE_BIN=claude
CLAUDE_SAFE_ALLOWED_TOOLS=Read,Edit,Bash
CLAUDE_FULL_ALLOWED_TOOLS=
RUST_LOG=info

# Group chat support (comma-separated group IDs, empty = disabled)
ALLOWED_GROUP_IDS=
# Max bot-to-bot turns per chain (0 = unlimited)
BOT_TO_BOT_MAX_TURNS=5

# Speech-to-text (voice messages)
SST_PYTHON=python3
SST_SCRIPT=../sst.py
SST_LANGUAGE=es
SST_ARCH=base

# ── Multi-agent mode (with agents.toml) ──
# When agents.toml exists, the vars above are ignored (each agent has its own config).
# Define one token per agent here. Reference them in agents.toml as ${VAR_NAME}
# SENKU_BOT_TOKEN=<token_from_botfather>
# THALOS_BOT_TOKEN=<token_from_botfather>
